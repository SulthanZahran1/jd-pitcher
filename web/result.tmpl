<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Pitch Result</title>
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'><rect width='16' height='16' rx='3' fill='%23fafafa'/><circle cx='8' cy='8' r='3.2' fill='%230b7a56'/></svg>">
  <link rel="stylesheet" href="/recruit/style.css">
</head>
<body>
  <main class="pitch-widget">
    <article class="pitch-card">
      <header class="pitch-card-header">
        <div>
          <p class="eyebrow">Generated angle</p>
          <h2>Evidence matched to this role</h2>
        </div>
        <span class="badge">AI Generated</span>
      </header>
      <div class="pitch-body">
        {{.PitchHTML}}
      </div>
      <footer class="result-footer">
        <a href="./" class="btn-back">Generate another</a>
      </footer>
    </article>
  </main>
</body>
</html>
